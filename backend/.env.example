# Copy to .env and fill in.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hijasi

FLASK_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-admin-token
PUBLIC_URL=http://127.0.0.1:5000

# Stripe test mode (https://dashboard.stripe.com/test/apikeys). Leave empty to use the mock gateway.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Wallet checkout demo: show the one-time code on the checkout page (set false when SMS is wired up).
DEMO_SHOW_CODES=true

# Outgoing email via a cPanel mailbox (leave SMTP_HOST empty locally: emails print to the log)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=no-reply@kassara.org
SMTP_PASSWORD=
MAIL_FROM=no-reply@kassara.org
